---
/** Discreet ornament: hairlines framing an 8-point star. Use at most once per section. */
---

<span class="divider" aria-hidden="true">
  <svg viewBox="0 0 24 24" width="14" height="14">
    <path d="M12 2.5l2.3 4.2 4.4-1.9-1.9 4.4L21 11.5l-4.2 2.3 1.9 4.4-4.4-1.9L12 20.5l-2.3-4.2-4.4 1.9 1.9-4.4L3 11.5l4.2-2.3-1.9-4.4 4.4 1.9z" />
  </svg>
</span>

<style>
  .divider {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-accent);
  }

  .divider::before,
  .divider::after {
    content: '';
    inline-size: 3rem;
    block-size: 1px;
    background: currentColor;
    opacity: 0.6;
  }

  .divider svg {
    fill: currentColor;
  }
</style>
