  | 'mosque'
  | 'tasbih'
  | 'diamond'
  | 'bed'
  | 'lotus'
  | 'pin'
  | 'bell'
  | 'woman'
  | 'hotel';

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 24, label, class: className } = Astro.props;

