---
/**
 * Button / link-button.
 * Variants adapt automatically inside `.theme-cherry` / `.theme-night` through semantic tokens.
 *  - primary:   solid Black Cherry — one per view, the main action
 *  - secondary: Rose Gold hairline — supporting action
 *  - text:      underlined link with arrow — tertiary, in-flow
 */
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import type { HTMLAttributes } from 'astro/types';

type Props = {
  href?: string;
  variant?: 'primary' | 'secondary' | 'text';
  size?: 'md' | 'lg';
  icon?: IconName;
  iconPosition?: 'start' | 'end';
  block?: boolean;
  external?: boolean;
} & Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'type'> & { type?: 'button' | 'submit' };

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  iconPosition = 'end',
  block = false,
  external = false,
  class: className,
  type = 'button',
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const classes = ['btn', `btn--${variant}`, `btn--${size}`, block && 'btn--block', className];
const linkAttrs = href
  ? { href, ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}) }
  : { type };
---

<Tag class:list={classes} {...linkAttrs} {...rest}>
  {icon && iconPosition === 'start' && <Icon name={icon} size={18} />}
  <span><slot /></span>
  {icon && iconPosition === 'end' && <Icon name={icon} size={18} />}
</Tag>

<style>
  /* Editorial pill buttons: tracked capitals, hairline borders. */
  .btn {
    --btn-height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    min-block-size: var(--btn-height);
    padding-inline: 1.75rem;
    border: 1px solid transparent;
    border-radius: var(--radius-button);
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.2em;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .btn:active {
    transform: translateY(1px);
  }

  .btn--lg {
    --btn-height: 3.375rem;
    padding-inline: 2.25rem;
  }

  .btn--block {
    display: flex;
    inline-size: 100%;
  }

  /* Primary: Black Cherry with a fine gold edge. */
  .btn--primary {
    background-color: var(--color-primary);
    border-color: var(--color-border-strong);
    color: var(--color-on-primary);
  }

  .btn--primary:hover {
    background-color: var(--color-primary-hover);
    border-color: var(--color-ornament);
    box-shadow: 0 10px 30px rgb(10 1 4 / 0.35);
  }

  /* Secondary: transparent pill with an antique-rose hairline. */
  .btn--secondary {
    background-color: transparent;
    border-color: var(--color-ring);
    color: var(--color-heading);
  }

  .btn--secondary:hover {
    background-color: color-mix(in srgb, var(--color-accent-text) 10%, transparent);
    border-color: var(--color-accent-text);
  }

  /* Text link: capitals with the arrow set in a fine circle. */
  .btn--text {
    --btn-height: 2.75rem;
    padding-inline: 0;
    color: var(--color-heading);
    border-radius: 0;
  }

  .btn--text :global(svg) {
    box-sizing: content-box;
    padding: 0.45rem;
    border: 1px solid var(--color-ring);
    border-radius: 50%;
  }

  .btn--text:hover :global(svg) {
    border-color: var(--color-ornament);
  }

  .btn :global(svg) {
    flex-shrink: 0;
    transition:
      transform var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  .btn--text :global(svg),
  .btn--primary :global(svg),
  .btn--secondary :global(svg) {
    inline-size: 1rem;
    block-size: 1rem;
  }

  .btn:hover :global(.icon--arrow-right) {
    transform: translateX(3px);
  }

  /* Arabic: no capitals or tracking; a slightly larger size. */
  :global(:root[lang='ar']) .btn {
    font-size: 0.875rem;
    font-weight: var(--weight-medium);
  }
</style>
