---
/**
 * "Nos séjours" — until departures are confirmed, the section invites a
 * request rather than showing prices or dates. Editorial spread: an immersive
 * photograph of Masjid al-Haram at dusk in a tall arch on the start side;
 * heading, intro, the numbered contents of the detailed programme on
 * hairlines and the Black Cherry call to action on the other.
 */
import { Image } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import { media } from '@/config/media';
import { getContent, getLang, mediaAlt, ui } from '@/i18n';
import { whatsappHref, isWhatsappConfigured } from '@/config/site';

const lang = getLang(Astro.currentLocale);
const { programmes, eligibility } = getContent(lang);
const photo = media.hero;
---

<section id="programmes" class="offer theme-dark" aria-labelledby="programmes-title">
  <div class="container offer__inner">
    <div class="offer__visual" data-reveal>
      <figure class="offer__photo">
        <Image
          src={photo.src}
          alt={mediaAlt('hero', lang)}
          widths={[480, 720, 960]}
          sizes="(min-width: 64em) 38vw, 90vw"
          loading="lazy"
          class="offer__img"
        />
      </figure>
      <p class="offer__badge">
        <span class="sparkle" aria-hidden="true"></span>
        {eligibility.label}
      </p>
    </div>

    <div class="offer__content" data-reveal style="--reveal-delay: 120ms">
      <p class="eyebrow">{programmes.eyebrow}</p>
      <h2 id="programmes-title" class="offer__title">{programmes.title}</h2>
      <p class="offer__intro">{programmes.intro}</p>

      <p class="offer__list-title">{ui[lang].programmesCardTitle}</p>
      <ol role="list" class="offer__list">
        {
          programmes.included.map((item, i) => (
            <li>
              <span class="offer__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ol>

      <div class="offer__cta">
        <Button
          href={whatsappHref(programmes.whatsappMessage)}
          external={isWhatsappConfigured}
          size="lg"
          icon="whatsapp"
          iconPosition="start"
        >
          {programmes.cta}
        </Button>
        <p class="offer__note">{programmes.note}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .offer {
    position: relative;
    padding-block: var(--section-space);
  }

  .offer__inner {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 6rem);
    align-items: center;
  }

  /* ---- Photograph ---- */
  .offer__visual {
    position: relative;
    justify-self: center;
    inline-size: min(100%, 24rem);
    padding: 0.75rem;
    border: 1px solid var(--gold-line);
    border-radius: var(--radius-arch-soft);
  }

  .offer__photo {
    margin: 0;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: var(--radius-arch-soft);
    background: var(--color-placeholder);
  }

  .offer__img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 52% 100%;
    /* Anchored low and enlarged so the construction cranes stay out of frame. */
    transform: scale(1.75);
    transform-origin: 52% 100%;
  }

  .offer__badge {
    position: absolute;
    inset-block-end: 2rem;
    inset-inline: 50% auto;
    translate: -50% 0;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--gold-line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--wine-950) 82%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    font-size: var(--text-2xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-heading);
  }

  :global([dir='rtl']) .offer__badge {
    translate: 50% 0;
  }

  :global(:root[lang='ar']) .offer__badge {
    font-size: 0.8125rem;
  }

  /* ---- Content ---- */
  .offer__content {
    display: grid;
    justify-items: start;
    gap: var(--space-md);
  }

  .offer__title {
    font-size: var(--text-3xl);
    line-height: 1.06;
  }

  .offer__intro {
    font-size: var(--text-base);
    font-weight: var(--weight-light);
    line-height: 1.8;
    color: var(--color-text-muted);
  }

  .offer__list-title {
    margin-block-start: var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--color-accent-text);
  }

  :global(:root[lang='ar']) .offer__list-title {
    font-style: normal;
  }

  .offer__list {
    inline-size: 100%;
    border-block-start: var(--border-hairline);
  }

  .offer__list li {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    padding-block: 0.85rem;
    border-block-end: var(--border-hairline);
    font-size: var(--text-base);
    color: var(--color-heading);
  }

  .offer__num {
    flex: none;
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    color: var(--color-accent-text);
  }

  .offer__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-lg);
    margin-block-start: var(--space-sm);
  }

  .offer__note {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (max-width: 23.99em) {
    .offer__badge {
      letter-spacing: 0.08em;
      padding-inline: 0.8rem;
    }
  }

  @media (min-width: 64em) {
    .offer__inner {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    }
  }
</style>
