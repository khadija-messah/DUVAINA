---
/**
 * "Le confort au cœur de votre Omra" — the 5-star hotels in Mecca and Medina,
 * as two large, distinct compositions that alternate sides:
 *  - an arched view of the holy site, a framed room photograph overlapping
 *    its foot, a fine gold arch line and a sparkle;
 *  - the Arabic name, the city in light serif, a discreet 5-star mention,
 *    a short line and three comfort indicators on hairlines.
 * Below, the four services of the stay in a quiet row, then the note.
 * States only the 5-star category: no hotel name, price or distance.
 */
import { Image } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getContent, getLang, mediaAlt } from '@/i18n';
import { media, type MediaSlot } from '@/config/media';

const lang = getLang(Astro.currentLocale);
const { hotels, heroPromo } = getContent(lang);
---

<section id="hotels" class="hotels theme-dark" aria-labelledby="hotels-title">
  <div class="container">
    <SectionHeading id="hotels-title" eyebrow={hotels.eyebrow} title={hotels.title} intro={hotels.intro} align="center" />

    <ul role="list" class="hotels__list">
      {
        hotels.destinations.map((d, i) => {
          const scene = media[d.slot] as MediaSlot;
          const room = media[d.room] as MediaSlot;
          return (
            <li class:list={['stay', i % 2 === 1 && 'stay--reverse']}>
              <div class="stay__visual" data-reveal>
                <span class="stay__arch-line" aria-hidden="true">
                  <span class="sparkle" />
                </span>
                <figure class="stay__scene">
                  <Image
                    src={scene.src!}
                    alt={mediaAlt(d.slot, lang)}
                    widths={[480, 720, 960]}
                    sizes="(min-width: 64em) 36vw, 86vw"
                    loading="lazy"
                    class="stay__img"
                    style={scene.position ? `object-position: ${scene.position}` : undefined}
                  />
                </figure>
                <figure class="stay__room">
                  <Image
                    src={room.src!}
                    alt={mediaAlt(d.room, lang)}
                    widths={[320, 480]}
                    sizes="(min-width: 64em) 18vw, 46vw"
                    loading="lazy"
                    class="stay__img"
                  />
                </figure>
              </div>

              <div class="stay__body" data-reveal style="--reveal-delay: 120ms">
                <p class="stay__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
                {/* Always Arabic: the city's Arabic name (FR) or its traditional epithet (AR). */}
                <p class="stay__alt arabic" lang="ar" dir="rtl">{d.cityAlt}</p>
                <h3 class="stay__city">{d.city}</h3>
                <p class="stay__badge">
                  <span class="stay__stars" aria-hidden="true">
                    {Array.from({ length: 5 }, () => <Icon name="star5" size={10} />)}
                  </span>
                  {hotels.badge}
                </p>
                <p class="stay__text">{d.text}</p>
                <ul role="list" class="stay__indicators">
                  {heroPromo.indicators.map((it) => (
                    <li>
                      <Icon name={it.icon} size={18} />
                      <span>{it.label}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          );
        })
      }
    </ul>

    <ul role="list" class="hotels__services" data-reveal>
      {
        heroPromo.benefits.map((b) => (
          <li class="service">
            <span class="service__icon" aria-hidden="true">
              <Icon name={b.icon} size={26} />
            </span>
            <span class="service__label">{b.label}</span>
          </li>
        ))
      }
    </ul>

    <p class="hotels__note" data-reveal>{hotels.note}</p>
  </div>
</section>

<style>
  .hotels {
    padding-block: clamp(2.5rem, 2rem + 2vw, 4rem) var(--section-space);
  }

  .hotels__list {
    display: grid;
    gap: clamp(3.5rem, 2.5rem + 3vw, 5.5rem);
  }

  /* ---- One city composition ---- */
  .stay {
    display: grid;
    gap: clamp(3rem, 2rem + 3vw, 4.5rem);
    align-items: center;
  }

  .stay__visual {
    position: relative;
    inline-size: min(100% - 2.5rem, 24rem);
    margin-block-start: 1.25rem;
    margin-inline-end: 2.5rem;
    margin-block-end: 3rem;
  }

  .stay__arch-line {
    position: absolute;
    inset-block: -1.25rem 3rem;
    inset-inline: 1.25rem -1.25rem;
    border: 1px solid var(--gold-line);
    border-block-end: 0;
    border-radius: var(--radius-arch);
    pointer-events: none;
  }

  .stay__arch-line .sparkle {
    position: absolute;
    inset-block-start: 40%;
    inset-inline-end: -0.4rem;
    inline-size: 0.8rem;
    block-size: 0.8rem;
  }

  .stay__scene,
  .stay__room {
    margin: 0;
    overflow: hidden;
    background: var(--color-placeholder);
  }

  .stay__scene {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-arch-soft);
    box-shadow: var(--shadow-md);
  }

  /* Room photograph overlapping the foot of the arch, framed in gold. */
  .stay__room {
    position: absolute;
    inset-block-end: -3rem;
    inset-inline-end: -2.5rem;
    inline-size: 52%;
    aspect-ratio: 4 / 3;
    padding: 5px;
    border: 1px solid var(--gold-line);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    box-shadow: var(--shadow-md);
  }

  .stay__room .stay__img {
    border-radius: calc(var(--radius-lg) - 4px);
  }

  .stay__img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform 1.6s var(--ease-out);
  }

  .stay__visual:hover .stay__scene .stay__img {
    transform: scale(1.03);
  }

  /* ---- Text ---- */
  .stay__body {
    display: grid;
    justify-items: start;
    max-inline-size: 32rem;
  }

  .stay__num {
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    color: var(--color-text-muted);
  }

  .stay__alt {
    inline-size: fit-content;
    margin-block-start: var(--space-md);
    font-size: var(--text-xl);
    line-height: 1.4;
    color: var(--color-accent-text);
  }

  .stay__city {
    font-size: clamp(2.25rem, 1.8rem + 1.8vw, 3.25rem);
    font-weight: var(--weight-light);
    line-height: 1;
  }

  .stay__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-block-start: var(--space-md);
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--gold-line);
    border-radius: 999px;
    font-size: var(--text-2xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-heading);
  }

  .stay__stars {
    display: inline-flex;
    gap: 2px;
    color: var(--color-ornament);
  }

  .stay__stars :global(svg) {
    fill: currentColor;
    stroke: none;
  }

  .stay__text {
    margin-block-start: var(--space-md);
    font-size: var(--text-base);
    font-weight: var(--weight-light);
    line-height: 1.8;
    color: var(--color-text-muted);
  }

  .stay__indicators {
    inline-size: 100%;
    margin-block-start: var(--space-lg);
    border-block-start: var(--border-hairline);
  }

  .stay__indicators li {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding-block: 0.8rem;
    border-block-end: var(--border-hairline);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-heading);
  }

  .stay__indicators :global(svg) {
    flex: none;
    color: var(--color-ornament);
    stroke-width: 1.2;
  }

  /* ---- Services row ---- */
  .hotels__services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-block-start: clamp(3rem, 2.5rem + 2vw, 4.5rem);
    border-block: var(--border-hairline);
  }

  .service {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-sm);
    text-align: center;
  }

  .service:nth-child(even) {
    border-inline-start: var(--border-hairline);
  }

  .service:nth-child(n + 3) {
    border-block-start: var(--border-hairline);
  }

  .service__icon {
    color: var(--color-ornament);
  }

  .service__icon :global(svg) {
    stroke-width: 1.1;
  }

  .service__label {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.3;
    color: var(--color-heading);
  }

  .hotels__note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    max-inline-size: none;
    margin-block-start: var(--space-lg);
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--color-text-muted);
    text-align: center;
  }

  .hotels__note::before {
    content: '';
    flex: none;
    inline-size: 0.6875rem;
    block-size: 0.6875rem;
    background: var(--color-ornament);
    -webkit-mask: var(--sparkle) center / contain no-repeat;
    mask: var(--sparkle) center / contain no-repeat;
  }

  :global(:root[lang='ar']) .hotels__note {
    font-style: normal;
    font-size: 0.875rem;
  }

  :global(:root[lang='ar']) .stay__badge {
    font-size: 0.8125rem;
    text-transform: none;
  }

  @media (min-width: 40em) {
    .stay__visual {
      justify-self: center;
    }
  }

  @media (min-width: 64em) {
    .stay {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(3rem, 6vw, 7rem);
    }

    .stay__visual {
      justify-self: center;
    }

    /* Medina: photo on the end side. */
    .stay--reverse .stay__visual {
      order: 2;
    }

    .hotels__services {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .service:nth-child(n + 3) {
      border-block-start: 0;
    }

    .service + .service {
      border-inline-start: var(--border-hairline);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stay__visual:hover .stay__scene .stay__img {
      transform: none;
    }
  }
</style>
